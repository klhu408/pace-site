{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pace-location-share",
  "main": "./worker.js",
  "compatibility_date": "2026-10-21",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGINS": "http://localhost:8000,http://127.0.0.1:8000,https://YOUR_ACCOUNT.github.io"
  },
  "durable_objects": {
    "bindings": [
      { "name": "LOCATION_ROOMS", "class_name": "LocationRoom" }
    ]
  },
  "exports": {
    "LocationRoom": { "type": "durable-object", "storage": "sqlite" }
  }
}
